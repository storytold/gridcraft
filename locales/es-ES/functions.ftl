fn-SECOND = Devuelve el segundo (0-59) de una hora.
    .args = núm_de_serie
fn-SEQUENCE = Crea una matriz de números con un paso uniforme.
    .args = filas, [columnas], [inicio], [paso]
fn-SERIESSUM = Suma de una serie de potencias.
    .args = x, n, m, coeficientes
fn-SHEET = Número de hoja.
    .args = [valor]
fn-SHEETS = Número de hojas.
    .args = [referencia]
fn-SIGN = 1 para positivo, -1 para negativo y 0 para cero.
    .args = número
fn-SIN = Seno de un ángulo en radianes.
    .args = número
fn-SINH = Seno hiperbólico.
    .args = número
fn-SKEW = Asimetría muestral.
    .args = número1, [número2], ...
fn-SKEW-P = Asimetría poblacional.
    .args = número1, [número2], ...
fn-SLN = Amortización lineal de un período.
    .args = costo, valor_residual, vida
fn-SLOPE = Pendiente de la recta de regresión por mínimos cuadrados.
    .args = conocido_y, conocido_x
fn-SMALL = El k-ésimo número menor de un conjunto de datos.
    .args = matriz, k
fn-SORT = Ordena las filas (o columnas) de una matriz según una o varias de sus columnas.
    .args = matriz, [índice_orden], [criterio_orden], [por_col]
fn-SORTBY = Ordena una matriz según los valores de otras matrices del mismo tamaño.
    .args = matriz, por_matriz1, [criterio_orden1], ...
fn-SQRT = Raíz cuadrada positiva.
    .args = número
fn-SQRTPI = Raíz cuadrada del número multiplicado por pi.
    .args = número
fn-STANDARDIZE = Puntuación z de un valor.
    .args = x, media, desv_estándar
fn-STDEV = Desviación estándar muestral.
    .args = número1, [número2], ...
fn-STDEV-P = Desviación estándar poblacional.
    .args = número1, [número2], ...
fn-STDEV-S = Desviación estándar muestral.
    .args = número1, [número2], ...
fn-STDEVA = Desviación estándar muestral, contando el texto como 0 y los valores lógicos como 1 o 0.
    .args = valor1, [valor2], ...
fn-STDEVP = Desviación estándar poblacional.
    .args = número1, [número2], ...
fn-STDEVPA = Desviación estándar poblacional, contando el texto como 0 y los valores lógicos como 1 o 0.
    .args = valor1, [valor2], ...
fn-STEYX = Error estándar de los valores y pronosticados en una regresión.
    .args = conocido_y, conocido_x
fn-SUBSTITUTE = Reemplaza las apariciones de un texto por otro, opcionalmente solo una aparición concreta.
    .args = texto, texto_original, texto_nuevo, [núm_instancia]
fn-SUBTOTAL = Un subtotal que puede omitir las filas ocultas.
    .args = núm_función, ref1, ...
fn-SUM = Suma todos los números de los argumentos.
    .args = número1, [número2], ...
fn-SUMIF = Suma las celdas que cumplen una condición.
    .args = rango, criterio, [rango_suma]
fn-SUMIFS = Suma las celdas que cumplen todas las condiciones.
    .args = rango_suma, rango_criterios1, criterio1, ...
fn-SUMPRODUCT = Multiplica los elementos correspondientes de matrices del mismo tamaño y suma los productos.
    .args = matriz1, [matriz2], ...
fn-SUMSQ = Suma los cuadrados de los números.
    .args = número1, [número2], ...
fn-SUMX2MY2 = Suma las diferencias de cuadrados de los elementos correspondientes.
    .args = matriz_x, matriz_y
fn-SUMX2PY2 = Suma las sumas de cuadrados de los elementos correspondientes.
    .args = matriz_x, matriz_y
fn-SUMXMY2 = Suma los cuadrados de las diferencias de los elementos correspondientes.
    .args = matriz_x, matriz_y
fn-SWITCH = Compara una expresión con una lista de valores y devuelve el resultado asociado a la primera coincidencia.
    .args = expresión, valor1, resultado1, [predeterminado_o_valor2, resultado2], ...
fn-SYD = Amortización por suma de dígitos de los años de un período.
    .args = costo, valor_residual, vida, período
fn-T = Devuelve el valor si es texto y, si no, texto vacío.
    .args = valor
fn-T-DIST = Densidad t de Student o probabilidad de cola izquierda.
    .args = x, grados_libertad, acumulado
fn-T-DIST-2T = Probabilidad t de Student de dos colas.
    .args = x, grados_libertad
fn-T-DIST-RT = Probabilidad t de Student de cola derecha.
    .args = x, grados_libertad
fn-T-INV = Inversa de cola izquierda de la distribución t de Student.
    .args = probabilidad, grados_libertad
fn-T-INV-2T = Inversa de dos colas de la distribución t de Student.
    .args = probabilidad, grados_libertad
fn-T-TEST = Probabilidad de la prueba t de Student.
    .args = matriz1, matriz2, colas, tipo
fn-TAKE = Conserva filas o columnas del principio (o del final) de una matriz.
    .args = matriz, filas, [columnas]
fn-TAN = Tangente de un ángulo en radianes.
    .args = número
fn-TANH = Tangente hiperbólica.
    .args = número
fn-TBILLEQ = Rendimiento equivalente a un bono de una letra del Tesoro.
    .args = liquidación, vencimiento, descuento
fn-TBILLPRICE = Precio por cada 100 de valor nominal de una letra del Tesoro.
    .args = liquidación, vencimiento, descuento
fn-TBILLYIELD = Rendimiento de una letra del Tesoro.
    .args = liquidación, vencimiento, precio
fn-TDIST = Probabilidad t de Student de una o dos colas.
    .args = x, grados_libertad, colas
fn-TEXT = Da formato de texto a un número.
    .args = valor, formato
fn-TEXTAFTER = Devuelve el texto que sigue a un delimitador.
    .args = texto, delimitador, [núm_instancia], [modo_coincidencia], [coincidir_final], [si_no_se_encuentra]
fn-TEXTBEFORE = Devuelve el texto que precede a un delimitador.
    .args = texto, delimitador, [núm_instancia], [modo_coincidencia], [coincidir_final], [si_no_se_encuentra]
fn-TEXTJOIN = Une texto de valores y rangos con un delimitador, omitiendo opcionalmente los elementos vacíos.
    .args = delimitador, ignorar_vacías, texto1, [texto2], ...
fn-TEXTSPLIT = Divide un texto en una cuadrícula de columnas y filas según los delimitadores indicados.
    .args = texto, delimitador_col, [delimitador_fila], [ignorar_vacías], [modo_coincidencia], [valor_relleno]
fn-TIME = Crea una hora (una fracción de día) a partir de horas, minutos y segundos.
    .args = hora, minuto, segundo
fn-TIMEVALUE = Convierte una hora escrita como texto en una fracción de día.
    .args = texto_hora
fn-TINV = Inversa de dos colas de la distribución t de Student.
    .args = probabilidad, grados_libertad
fn-TOCOL = Aplana una matriz en una sola columna, omitiendo opcionalmente los espacios en blanco o los errores.
    .args = matriz, [ignorar], [examinar_por_columna]
fn-TODAY = Devuelve la fecha actual.
fn-TOROW = Aplana una matriz en una sola fila, omitiendo opcionalmente los espacios en blanco o los errores.
    .args = matriz, [ignorar], [examinar_por_columna]
fn-TRANSPOSE = Intercambia las filas y las columnas de una matriz.
    .args = matriz
fn-TREND = Valores a lo largo de un ajuste lineal por mínimos cuadrados.
    .args = conocido_y, [conocido_x], [nueva_x], [constante]
fn-TRIM = Quita los espacios iniciales y finales y reduce las series de espacios a uno solo.
    .args = texto
fn-TRIMMEAN = Media tras recortar una fracción de puntos de ambos extremos.
    .args = matriz, porcentaje
fn-TRUE = Devuelve el valor lógico VERDADERO.
fn-TRUNC = Corta la parte decimal de un número en los dígitos indicados.
    .args = número, [núm_decimales]
fn-TTEST = Probabilidad de la prueba t de Student.
    .args = matriz1, matriz2, colas, tipo
fn-TYPE = Devuelve un código según el tipo de valor: 1 número, 2 texto, 4 lógico, 16 error, 64 matriz.
    .args = valor
fn-UNICHAR = Devuelve el carácter de un punto de código Unicode.
    .args = número
fn-UNICODE = Devuelve el punto de código Unicode del primer carácter de un texto.
    .args = texto
fn-UNIQUE = Devuelve las filas o columnas distintas de una matriz.
    .args = matriz, [por_col], [exactamente_una_vez]
fn-UPPER = Convierte el texto a mayúsculas.
    .args = texto
fn-VALUE = Convierte en número un texto con aspecto de número, fecha u hora.
    .args = texto
fn-VALUETOTEXT = Convierte cualquier valor en texto, opcionalmente en forma estricta (entre comillas).
    .args = valor, [formato]
fn-VAR = Varianza muestral.
    .args = número1, [número2], ...
fn-VAR-P = Varianza poblacional.
    .args = número1, [número2], ...
fn-VAR-S = Varianza muestral.
    .args = número1, [número2], ...
fn-VARA = Varianza muestral, contando el texto como 0 y los valores lógicos como 1 o 0.
    .args = valor1, [valor2], ...
fn-VARP = Varianza poblacional.
    .args = número1, [número2], ...
fn-VARPA = Varianza poblacional, contando el texto como 0 y los valores lógicos como 1 o 0.
    .args = valor1, [valor2], ...
fn-VDB = Amortización por saldo decreciente en cualquier tramo de períodos, con cambio a método lineal.
    .args = costo, valor_residual, vida, período_inicial, período_final, [factor], [sin_cambio]
fn-VLOOKUP = Busca un valor en la primera columna de una tabla y devuelve el valor de la misma fila de otra columna.
    .args = valor_buscado, matriz_buscar_en, indicador_columnas, [ordenado]
fn-VSTACK = Apila matrices una encima de otra.
    .args = matriz1, [matriz2], ...
fn-WEBSERVICE = Obtiene datos de un servicio web (no disponible; devuelve #¡VALOR!).
    .args = url
fn-WEEKDAY = Devuelve el día de la semana de una fecha como número.
    .args = núm_de_serie, [tipo]
fn-WEEKNUM = Devuelve el número de semana de una fecha dentro de su año.
    .args = núm_de_serie, [tipo]
fn-WEIBULL = Densidad o probabilidad de Weibull.
    .args = x, alfa, beta, acumulado
fn-WEIBULL-DIST = Densidad o probabilidad de Weibull.
    .args = x, alfa, beta, acumulado
fn-WORKDAY = Devuelve la fecha situada un número de días laborables antes o después de una fecha.
    .args = fecha_inicial, días, [festivos]
fn-WORKDAY-INTL = Devuelve la fecha situada a un número de días laborables de distancia con un fin de semana personalizado.
    .args = fecha_inicial, días, [fin_de_semana], [festivos]
fn-WRAPCOLS = Divide una fila o columna en columnas de la longitud indicada.
    .args = vector, núm_ajuste, [valor_relleno]
fn-WRAPROWS = Divide una fila o columna en filas de la longitud indicada.
    .args = vector, núm_ajuste, [valor_relleno]
fn-XIRR = Tasa interna de retorno de flujos de caja en fechas concretas.
    .args = valores, fechas, [estimar]
fn-XLOOKUP = Busca en una fila o columna y devuelve el elemento, la fila o la columna correspondiente de otra matriz.
    .args = valor_buscado, matriz_buscada, matriz_devuelta, [si_no_se_encuentra], [modo_de_coincidencia], [modo_de_búsqueda]
fn-XMATCH = Devuelve la posición de un valor en una fila o columna con modos flexibles de coincidencia y búsqueda.
    .args = valor_buscado, matriz_buscada, [modo_de_coincidencia], [modo_de_búsqueda]
fn-XNPV = Valor actual neto de flujos de caja en fechas concretas.
    .args = tasa, valores, fechas
fn-XOR = VERDADERO cuando un número impar de argumentos son VERDADERO.
    .args = valor_lógico1, [valor_lógico2], ...
fn-YEAR = Devuelve el año de una fecha.
    .args = núm_de_serie
fn-YEARFRAC = Devuelve la fracción de año entre dos fechas según una base de cómputo de días.
    .args = fecha_inicial, fecha_final, [base]
fn-YIELD = Rendimiento de un valor que paga intereses periódicos.
    .args = liquidación, vencimiento, tasa, precio, amortización, frecuencia, [base]
fn-YIELDDISC = Rendimiento anual de un valor con descuento.
    .args = liquidación, vencimiento, precio, amortización, [base]
fn-YIELDMAT = Rendimiento anual de un valor que paga intereses al vencimiento.
    .args = liquidación, vencimiento, emisión, tasa, precio, [base]
fn-Z-TEST = Probabilidad de una cola de una prueba z.
    .args = matriz, x, [sigma]
fn-ZTEST = Probabilidad de una cola de una prueba z.
    .args = matriz, x, [sigma]
