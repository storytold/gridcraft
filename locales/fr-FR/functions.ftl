fn-SEQUENCE = Construit une matrice de nombres espacés d'un pas régulier.
    .args = lignes, [colonnes], [début], [pas]
fn-SERIESSUM = Somme d'une série entière.
    .args = x, n, m, coefficients
fn-SHEET = Numéro de feuille.
    .args = [valeur]
fn-SHEETS = Nombre de feuilles.
    .args = [référence]
fn-SIGN = 1 pour un nombre positif, -1 pour un nombre négatif et 0 pour zéro.
    .args = nombre
fn-SIN = Sinus d'un angle en radians.
    .args = nombre
fn-SINH = Sinus hyperbolique.
    .args = nombre
fn-SKEW = Coefficient d'asymétrie d'un échantillon.
    .args = nombre1, [nombre2], ...
fn-SKEW-P = Coefficient d'asymétrie d'une population.
    .args = nombre1, [nombre2], ...
fn-SLN = Amortissement linéaire pour une période.
    .args = coût, valeur_résiduelle, durée_vie
fn-SLOPE = Pente de la droite de régression des moindres carrés.
    .args = y_connus, x_connus
fn-SMALL = Le k-ième plus petit nombre d'une série de données.
    .args = matrice, k
fn-SORT = Trie les lignes (ou les colonnes) d'une matrice selon une ou plusieurs de ses colonnes.
    .args = matrice, [index_tri], [ordre_tri], [par_colonne]
fn-SORTBY = Trie une matrice d'après les valeurs d'autres matrices de même taille.
    .args = matrice, par_matrice1, [ordre_tri1], ...
fn-SQRT = Racine carrée positive.
    .args = nombre
fn-SQRTPI = Racine carrée du nombre multiplié par pi.
    .args = nombre
fn-STANDARDIZE = Valeur centrée réduite d'une valeur.
    .args = x, moyenne, écart_type
fn-STDEV = Écart type d'échantillon.
    .args = nombre1, [nombre2], ...
fn-STDEV-P = Écart type de population.
    .args = nombre1, [nombre2], ...
fn-STDEV-S = Écart type d'échantillon.
    .args = nombre1, [nombre2], ...
fn-STDEVA = Écart type d'échantillon, le texte comptant pour 0 et les valeurs logiques pour 1 ou 0.
    .args = valeur1, [valeur2], ...
fn-STDEVP = Écart type de population.
    .args = nombre1, [nombre2], ...
fn-STDEVPA = Écart type de population, le texte comptant pour 0 et les valeurs logiques pour 1 ou 0.
    .args = valeur1, [valeur2], ...
fn-STEYX = Erreur type des valeurs y prévues dans une régression.
    .args = y_connus, x_connus
fn-SUBSTITUTE = Remplace les occurrences d'un texte par un autre, éventuellement une seule occurrence donnée.
    .args = texte, ancien_texte, nouveau_texte, [no_occurrence]
fn-SUBTOTAL = Un sous-total capable d'ignorer les lignes masquées.
    .args = no_fonction, réf1, ...
fn-SUM = Additionne tous les nombres des arguments.
    .args = nombre1, [nombre2], ...
fn-SUMIF = Additionne les cellules qui remplissent une condition.
    .args = plage, critères, [plage_somme]
fn-SUMIFS = Additionne les cellules qui remplissent toutes les conditions.
    .args = plage_somme, plage_critères1, critères1, ...
fn-SUMPRODUCT = Multiplie les éléments correspondants de matrices de même taille et additionne les produits.
    .args = matrice1, [matrice2], ...
fn-SUMSQ = Additionne les carrés des nombres.
    .args = nombre1, [nombre2], ...
fn-SUMX2MY2 = Additionne les différences des carrés des éléments correspondants.
    .args = matrice_x, matrice_y
fn-SUMX2PY2 = Additionne les sommes des carrés des éléments correspondants.
    .args = matrice_x, matrice_y
fn-SUMXMY2 = Additionne les carrés des différences des éléments correspondants.
    .args = matrice_x, matrice_y
fn-SWITCH = Compare une expression à une liste de valeurs et renvoie le résultat associé à la première correspondance.
    .args = expression, valeur1, résultat1, [défaut_ou_valeur2, résultat2], ...
fn-SYD = Amortissement par la somme des chiffres des années pour une période.
    .args = coût, valeur_résiduelle, durée_vie, période
fn-T = Renvoie la valeur si elle est du texte, sinon un texte vide.
    .args = valeur
fn-T-DIST = Densité ou probabilité unilatérale à gauche de la loi de Student.
    .args = x, degrés_liberté, cumulative
fn-T-DIST-2T = Probabilité bilatérale de la loi de Student.
    .args = x, degrés_liberté
fn-T-DIST-RT = Probabilité unilatérale à droite de la loi de Student.
    .args = x, degrés_liberté
fn-T-INV = Inverse unilatéral à gauche de la loi de Student.
    .args = probabilité, degrés_liberté
fn-T-INV-2T = Inverse bilatéral de la loi de Student.
    .args = probabilité, degrés_liberté
fn-T-TEST = Probabilité associée au test t de Student.
    .args = matrice1, matrice2, uni_bilatéral, type
fn-TAKE = Conserve des lignes ou des colonnes au début (ou à la fin) d'une matrice.
    .args = matrice, lignes, [colonnes]
fn-TAN = Tangente d'un angle en radians.
    .args = nombre
fn-TANH = Tangente hyperbolique.
    .args = nombre
fn-TBILLEQ = Rendement équivalent obligataire d'un bon du Trésor.
    .args = règlement, échéance, escompte
fn-TBILLPRICE = Prix pour une valeur nominale de 100 d'un bon du Trésor.
    .args = règlement, échéance, escompte
fn-TBILLYIELD = Rendement d'un bon du Trésor.
    .args = règlement, échéance, pr
fn-TDIST = Probabilité unilatérale ou bilatérale de la loi de Student.
    .args = x, degrés_liberté, uni_bilatéral
fn-TEXT = Met un nombre en forme de texte.
    .args = valeur, format_texte
fn-TEXTAFTER = Renvoie le texte situé après un délimiteur.
    .args = texte, délimiteur, [no_occurrence], [mode_correspondance], [correspondance_fin], [si_non_trouvé]
fn-TEXTBEFORE = Renvoie le texte situé avant un délimiteur.
    .args = texte, délimiteur, [no_occurrence], [mode_correspondance], [correspondance_fin], [si_non_trouvé]
fn-TEXTJOIN = Assemble le texte de valeurs et de plages avec un délimiteur, en ignorant éventuellement les éléments vides.
    .args = délimiteur, ignorer_vide, texte1, [texte2], ...
fn-TEXTSPLIT = Découpe un texte en grille de colonnes et de lignes selon les délimiteurs donnés.
    .args = texte, délimiteur_col, [délimiteur_lig], [ignorer_vide], [mode_correspondance], [remplir_avec]
fn-TIME = Construit une heure (une fraction de jour) à partir d'heures, de minutes et de secondes.
    .args = heure, minute, seconde
fn-TIMEVALUE = Convertit une heure écrite sous forme de texte en fraction de jour.
    .args = texte_heure
fn-TINV = Inverse bilatéral de la loi de Student.
    .args = probabilité, degrés_liberté
fn-TOCOL = Aplatit une matrice en une seule colonne, en ignorant éventuellement les cellules vides ou les erreurs.
    .args = matrice, [ignorer], [balayage_colonnes]
fn-TODAY = Renvoie la date du jour.
fn-TOROW = Aplatit une matrice en une seule ligne, en ignorant éventuellement les cellules vides ou les erreurs.
    .args = matrice, [ignorer], [balayage_colonnes]
fn-TRANSPOSE = Échange les lignes et les colonnes d'une matrice.
    .args = matrice
fn-TREND = Valeurs le long d'un ajustement linéaire par les moindres carrés.
    .args = y_connus, [x_connus], [x_nouveaux], [constante]
fn-TRIM = Supprime les espaces en début et en fin de texte et réduit les suites d'espaces à un seul.
    .args = texte
fn-TRIMMEAN = Moyenne après suppression d'une fraction des points aux deux extrémités.
    .args = matrice, pourcentage
fn-TRUE = Renvoie la valeur logique VRAI.
fn-TRUNC = Tronque la partie décimale d'un nombre au nombre de chiffres donné.
    .args = nombre, [no_chiffres]
fn-TTEST = Probabilité associée au test t de Student.
    .args = matrice1, matrice2, uni_bilatéral, type
fn-TYPE = Renvoie un code selon le genre de valeur : 1 nombre, 2 texte, 4 logique, 16 erreur, 64 matrice.
    .args = valeur
fn-UNICHAR = Renvoie le caractère correspondant à un point de code Unicode.
    .args = nombre
fn-UNICODE = Renvoie le point de code Unicode du premier caractère d'un texte.
    .args = texte
fn-UNIQUE = Renvoie les lignes ou les colonnes distinctes d'une matrice.
    .args = matrice, [par_colonne], [occurrence_unique]
fn-UPPER = Convertit un texte en majuscules.
    .args = texte
fn-VALUE = Convertit en nombre un texte qui ressemble à un nombre, à une date ou à une heure.
    .args = texte
fn-VALUETOTEXT = Convertit n'importe quelle valeur en texte, éventuellement sous forme stricte (entre guillemets).
    .args = valeur, [format]
fn-VAR = Variance d'échantillon.
    .args = nombre1, [nombre2], ...
fn-VAR-P = Variance de population.
    .args = nombre1, [nombre2], ...
fn-VAR-S = Variance d'échantillon.
    .args = nombre1, [nombre2], ...
fn-VARA = Variance d'échantillon, le texte comptant pour 0 et les valeurs logiques pour 1 ou 0.
    .args = valeur1, [valeur2], ...
fn-VARP = Variance de population.
    .args = nombre1, [nombre2], ...
fn-VARPA = Variance de population, le texte comptant pour 0 et les valeurs logiques pour 1 ou 0.
    .args = valeur1, [valeur2], ...
fn-VDB = Amortissement à taux dégressif sur une plage quelconque de périodes, avec bascule vers l'amortissement linéaire.
    .args = coût, valeur_résiduelle, durée_vie, période_début, période_fin, [facteur], [sans_bascule]
fn-VLOOKUP = Cherche une valeur dans la première colonne d'un tableau et renvoie la valeur de la même ligne dans une autre colonne.
    .args = valeur_cherchée, table_matrice, no_index_col, [valeur_proche]
fn-VSTACK = Empile des matrices les unes sur les autres.
    .args = matrice1, [matrice2], ...
fn-WEBSERVICE = Récupère des données d'un service web (indisponible ; renvoie #VALEUR!).
    .args = url
fn-WEEKDAY = Renvoie le jour de la semaine d'une date sous forme de nombre.
    .args = numéro_série, [type_renvoi]
fn-WEEKNUM = Renvoie le numéro de semaine d'une date dans son année.
    .args = numéro_série, [type_renvoi]
fn-WEIBULL = Densité ou probabilité de la loi de Weibull.
    .args = x, alpha, bêta, cumulative
fn-WEIBULL-DIST = Densité ou probabilité de la loi de Weibull.
    .args = x, alpha, bêta, cumulative
fn-WORKDAY = Renvoie la date située un certain nombre de jours ouvrés avant ou après une date.
    .args = date_début, jours, [jours_fériés]
fn-WORKDAY-INTL = Renvoie la date située un certain nombre de jours ouvrés plus loin, avec un week-end personnalisé.
    .args = date_début, jours, [week_end], [jours_fériés]
fn-WRAPCOLS = Répartit une ligne ou une colonne en colonnes de la longueur donnée.
    .args = vecteur, nombre_par_bloc, [remplir_avec]
fn-WRAPROWS = Répartit une ligne ou une colonne en lignes de la longueur donnée.
    .args = vecteur, nombre_par_bloc, [remplir_avec]
fn-XIRR = Taux de rendement interne de flux de trésorerie à des dates précises.
    .args = valeurs, dates, [estimation]
fn-XLOOKUP = Recherche dans une ligne ou une colonne et renvoie l'élément, la ligne ou la colonne correspondant d'une autre matrice.
    .args = valeur_cherchée, tableau_recherche, tableau_renvoi, [si_non_trouvé], [mode_correspondance], [mode_recherche]
fn-XMATCH = Renvoie la position d'une valeur dans une ligne ou une colonne, avec des modes de correspondance et de recherche souples.
    .args = valeur_cherchée, tableau_recherche, [mode_correspondance], [mode_recherche]
fn-XNPV = Valeur actuelle nette de flux de trésorerie à des dates précises.
    .args = taux, valeurs, dates
fn-XOR = VRAI lorsqu'un nombre impair d'arguments sont VRAI.
    .args = valeur_logique1, [valeur_logique2], ...
fn-YEAR = Renvoie l'année d'une date.
    .args = numéro_série
fn-YEARFRAC = Renvoie la fraction d'année entre deux dates selon une base de décompte des jours.
    .args = date_début, date_fin, [base]
fn-YIELD = Rendement d'un titre qui rapporte des intérêts périodiques.
    .args = règlement, échéance, taux, pr, valeur_rachat, fréquence, [base]
fn-YIELDDISC = Rendement annuel d'un titre escompté.
    .args = règlement, échéance, pr, valeur_rachat, [base]
fn-YIELDMAT = Rendement annuel d'un titre qui rapporte des intérêts à l'échéance.
    .args = règlement, échéance, émission, taux, pr, [base]
fn-Z-TEST = Probabilité unilatérale d'un test z.
    .args = matrice, x, [sigma]
fn-ZTEST = Probabilité unilatérale d'un test z.
    .args = matrice, x, [sigma]
