fn-VAR-P = Varianza della popolazione.
    .args = num1, [num2], ...
fn-VAR-S = Varianza del campione.
    .args = num1, [num2], ...
fn-VARA = Varianza del campione, considerando il testo come 0 e i valori logici come 1/0.
    .args = valore1, [valore2], ...
fn-VARP = Varianza della popolazione.
    .args = num1, [num2], ...
fn-VARPA = Varianza della popolazione, considerando il testo come 0 e i valori logici come 1/0.
    .args = valore1, [valore2], ...
