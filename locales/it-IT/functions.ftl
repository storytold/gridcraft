fn-SMALL = Il k-esimo numero più piccolo di un insieme di dati.
    .args = matrice, k
fn-SORT = Ordina le righe (o le colonne) di una matrice in base a una o più delle sue colonne.
    .args = matrice, [indice_ordinamento], [ordine], [per_colonna]
fn-SORTBY = Ordina una matrice in base ai valori di altre matrici di dimensioni corrispondenti.
    .args = matrice, per_matrice1, [ordine1], ...
fn-SQRT = Radice quadrata positiva.
