fn-SERIESSUM = Soma de uma série de potências.
    .args = x, n, m, coeficientes
fn-SHEET = Número da folha de cálculo.
    .args = [valor]
fn-SHEETS = Número de folhas de cálculo.
    .args = [referência]
fn-SIGN = 1 para positivo, -1 para negativo e 0 para zero.
    .args = núm
fn-SIN = Seno de um ângulo em radianos.
    .args = núm
fn-SINH = Seno hiperbólico.
    .args = núm
fn-SKEW = Assimetria amostral.
    .args = núm1, [núm2], ...
fn-SKEW-P = Assimetria populacional.
    .args = núm1, [núm2], ...
fn-SLN = Depreciação linear de um período.
    .args = custo, valor_residual, vida_útil
fn-SLOPE = Inclinação da reta de regressão por mínimos quadrados.
    .args = ys_conhecidos, xs_conhecidos
fn-SMALL = O k-ésimo menor número de um conjunto de dados.
    .args = matriz, k
fn-SORT = Ordena as linhas (ou colunas) de uma matriz por uma ou mais das suas colunas.
    .args = matriz, [índice_classificação], [ordem_classificação], [por_coluna]
fn-SORTBY = Ordena uma matriz pelos valores de outras matrizes de tamanho correspondente.
    .args = matriz, por_matriz1, [ordem_classificação1], ...
fn-SQRT = Raiz quadrada positiva.
    .args = núm
fn-SQRTPI = Raiz quadrada do número multiplicado por pi.
    .args = núm
fn-STANDARDIZE = Valor normalizado (z) de um valor.
    .args = x, média, desvio_padrão
fn-STDEV = Desvio padrão amostral.
    .args = núm1, [núm2], ...
fn-STDEV-P = Desvio padrão populacional.
    .args = núm1, [núm2], ...
fn-STDEV-S = Desvio padrão amostral.
    .args = núm1, [núm2], ...
fn-STDEVA = Desvio padrão amostral, em que o texto conta como 0 e os valores lógicos como 1/0.
    .args = valor1, [valor2], ...
fn-STDEVP = Desvio padrão populacional.
    .args = núm1, [núm2], ...
fn-STDEVPA = Desvio padrão populacional, em que o texto conta como 0 e os valores lógicos como 1/0.
    .args = valor1, [valor2], ...
fn-STEYX = Erro padrão dos valores de y previstos numa regressão.
    .args = ys_conhecidos, xs_conhecidos
fn-SUBSTITUTE = Substitui ocorrências de um texto por outro, opcionalmente apenas uma ocorrência escolhida.
    .args = texto, texto_antigo, novo_texto, [núm_ocorrência]
fn-SUBTOTAL = Um subtotal que pode ignorar linhas ocultas.
    .args = núm_função, ref1, ...
fn-SUM = Soma todos os números dos argumentos.
    .args = núm1, [núm2], ...
fn-SUMIF = Soma as células que cumprem uma condição.
    .args = intervalo, critérios, [intervalo_soma]
fn-SUMIFS = Soma as células que cumprem todas as condições.
    .args = intervalo_soma, intervalo_critérios1, critérios1, ...
fn-SUMPRODUCT = Multiplica os elementos correspondentes de matrizes do mesmo tamanho e soma os produtos.
    .args = matriz1, [matriz2], ...
fn-SUMSQ = Soma os quadrados dos números.
    .args = núm1, [núm2], ...
fn-SUMX2MY2 = Soma as diferenças dos quadrados de elementos correspondentes.
    .args = matriz_x, matriz_y
fn-SUMX2PY2 = Soma as somas dos quadrados de elementos correspondentes.
    .args = matriz_x, matriz_y
fn-SUMXMY2 = Soma as diferenças ao quadrado de elementos correspondentes.
    .args = matriz_x, matriz_y
fn-SWITCH = Compara uma expressão com uma lista de valores e devolve o resultado associado à primeira correspondência.
    .args = expressão, valor1, resultado1, [padrão_ou_valor2, resultado2], ...
fn-SYD = Depreciação pela soma dos dígitos dos anos num período.
    .args = custo, valor_residual, vida_útil, per
fn-T = Devolve o valor se for texto; caso contrário, texto vazio.
    .args = valor
fn-T-DIST = Densidade t de Student ou probabilidade na cauda esquerda.
    .args = x, graus_liberdade, acumulado
fn-T-DIST-2T = Probabilidade t de Student bicaudal.
    .args = x, graus_liberdade
fn-T-DIST-RT = Probabilidade t de Student na cauda direita.
    .args = x, graus_liberdade
fn-T-INV = Inverso da distribuição t de Student na cauda esquerda.
    .args = probabilidade, graus_liberdade
fn-T-INV-2T = Inverso bicaudal da distribuição t de Student.
    .args = probabilidade, graus_liberdade
fn-T-TEST = Probabilidade do teste t de Student.
    .args = matriz1, matriz2, caudas, tipo
fn-TAKE = Mantém linhas ou colunas do início (ou do fim) de uma matriz.
    .args = matriz, linhas, [colunas]
fn-TAN = Tangente de um ângulo em radianos.
    .args = núm
fn-TANH = Tangente hiperbólica.
    .args = núm
fn-TBILLEQ = Rendimento equivalente a obrigação de um bilhete do Tesouro.
    .args = liquidação, vencimento, desconto
fn-TBILLPRICE = Preço por 100 de valor nominal de uma bilhete do Tesouro.
    .args = liquidação, vencimento, desconto
fn-TBILLYIELD = Rendimento de uma bilhete do Tesouro.
    .args = liquidação, vencimento, preço
fn-TDIST = Probabilidade t de Student unicaudal ou bicaudal.
    .args = x, graus_liberdade, caudas
fn-TEXT = Formata um número como texto.
    .args = valor, texto_formato
fn-TEXTAFTER = Devolve o texto que se encontra depois de um delimitador.
    .args = texto, delimitador, [núm_ocorrência], [modo_correspondência], [correspondência_fim], [se_não_encontrado]
fn-TEXTBEFORE = Devolve o texto que se encontra antes de um delimitador.
    .args = texto, delimitador, [núm_ocorrência], [modo_correspondência], [correspondência_fim], [se_não_encontrado]
fn-TEXTJOIN = Une o texto de valores e intervalos com um delimitador; os itens vazios podem ser ignorados.
    .args = delimitador, ignorar_vazios, texto1, [texto2], ...
fn-TEXTSPLIT = Divide o texto numa grelha de colunas e linhas nos delimitadores indicados.
    .args = texto, delimitador_coluna, [delimitador_linha], [ignorar_vazios], [modo_correspondência], [preencher_com]
fn-TIME = Cria um valor de hora (uma fração de dia) a partir de horas, minutos e segundos.
    .args = hora, minuto, segundo
fn-TIMEVALUE = Converte uma hora escrita como texto numa fração de dia.
    .args = texto_hora
fn-TINV = Inverso bicaudal da distribuição t de Student.
    .args = probabilidade, graus_liberdade
fn-TOCOL = Reduz uma matriz a uma única coluna; as células vazias ou os erros podem ser ignorados.
    .args = matriz, [ignorar], [varrer_por_coluna]
fn-TODAY = Devolve a data atual.
fn-TOROW = Reduz uma matriz a uma única linha; as células vazias ou os erros podem ser ignorados.
    .args = matriz, [ignorar], [varrer_por_coluna]
fn-TRANSPOSE = Troca as linhas e as colunas de uma matriz.
    .args = matriz
fn-TREND = Valores ao longo de um ajuste linear por mínimos quadrados.
    .args = ys_conhecidos, [xs_conhecidos], [novos_xs], [constante]
fn-TRIM = Remove os espaços no início e no fim e reduz as sequências de espaços a um só.
    .args = texto
fn-TRIMMEAN = Média após descartar uma fração dos pontos de ambas as extremidades.
    .args = matriz, percentagem
fn-TRUE = Devolve o valor lógico VERDADEIRO.
fn-TRUNC = Trunca um número, eliminando a parte fracionária, para o número de dígitos indicado.
    .args = núm, [núm_dígitos]
fn-TTEST = Probabilidade do teste t de Student.
    .args = matriz1, matriz2, caudas, tipo
fn-TYPE = Devolve um código para o tipo de valor: 1 número, 2 texto, 4 lógico, 16 erro, 64 matriz.
    .args = valor
fn-UNICHAR = Devolve o carácter de um ponto de código Unicode.
    .args = núm
fn-UNICODE = Devolve o ponto de código Unicode do primeiro carácter de um texto.
    .args = texto
fn-UNIQUE = Devolve as linhas ou colunas distintas de uma matriz.
    .args = matriz, [por_coluna], [exatamente_uma_vez]
fn-UPPER = Converte o texto em maiúsculas.
    .args = texto
fn-VALUE = Converte em número um texto com aspeto de número, data ou hora.
    .args = texto
fn-VALUETOTEXT = Converte qualquer valor em texto, opcionalmente na forma estrita (entre aspas).
    .args = valor, [formato]
fn-VAR = Variância amostral.
    .args = núm1, [núm2], ...
fn-VAR-P = Variância populacional.
    .args = núm1, [núm2], ...
fn-VAR-S = Variância amostral.
    .args = núm1, [núm2], ...
fn-VARA = Variância amostral, em que o texto conta como 0 e os valores lógicos como 1/0.
    .args = valor1, [valor2], ...
fn-VARP = Variância populacional.
    .args = núm1, [núm2], ...
fn-VARPA = Variância populacional, em que o texto conta como 0 e os valores lógicos como 1/0.
    .args = valor1, [valor2], ...
fn-VDB = Depreciação por saldo decrescente em qualquer intervalo de períodos, com passagem para o método linear.
    .args = custo, valor_residual, vida_útil, período_inicial, período_final, [fator], [sem_alternar]
fn-VLOOKUP = Procura um valor na primeira coluna de uma tabela e devolve o valor da mesma linha noutra coluna.
    .args = valor_procurado, matriz_tabela, núm_índice_coluna, [procurar_intervalo]
fn-VSTACK = Empilha matrizes umas sobre as outras.
    .args = matriz1, [matriz2], ...
fn-WEBSERVICE = Busca dados de um serviço web (indisponível; devolve #VALOR!).
    .args = url
fn-WEEKDAY = Devolve o dia da semana de uma data como número.
    .args = núm_série, [tipo_retorno]
fn-WEEKNUM = Devolve o número da semana de uma data dentro do ano.
    .args = núm_série, [tipo_retorno]
fn-WEIBULL = Densidade ou probabilidade de Weibull.
    .args = x, alfa, beta, acumulado
fn-WEIBULL-DIST = Densidade ou probabilidade de Weibull.
    .args = x, alfa, beta, acumulado
fn-WORKDAY = Devolve a data situada alguns dias úteis antes ou depois de uma data.
    .args = data_inicial, dias, [feriados]
fn-WORKDAY-INTL = Devolve a data situada alguns dias úteis à frente ou atrás, com um fim de semana personalizado.
    .args = data_inicial, dias, [fim_de_semana], [feriados]
fn-WRAPCOLS = Divide uma linha ou coluna em colunas do comprimento indicado.
    .args = vetor, quantidade_quebra, [preencher_com]
fn-WRAPROWS = Divide uma linha ou coluna em linhas do comprimento indicado.
    .args = vetor, quantidade_quebra, [preencher_com]
fn-XIRR = Taxa interna de rentabilidade de fluxos de caixa em datas específicas.
    .args = valores, datas, [estimativa]
fn-XLOOKUP = Procura numa linha ou coluna e devolve o item, a linha ou a coluna correspondente de outra matriz.
    .args = valor_procurado, matriz_procurada, matriz_retorno, [se_não_encontrado], [modo_correspondência], [modo_busca]
fn-XMATCH = Devolve a posição de um valor numa linha ou coluna com modos flexíveis de correspondência e de busca.
    .args = valor_procurado, matriz_procurada, [modo_correspondência], [modo_busca]
fn-XNPV = Valor atual líquido de fluxos de caixa em datas específicas.
    .args = taxa, valores, datas
fn-XOR = VERDADEIRO quando um número ímpar de argumentos é VERDADEIRO.
    .args = lógico1, [lógico2], ...
fn-YEAR = Devolve o ano de uma data.
    .args = núm_série
fn-YEARFRAC = Devolve a fração de um ano entre duas datas segundo uma base de contagem de dias.
    .args = data_inicial, data_final, [base_contagem]
fn-YIELD = Rendimento de um título que paga juros periódicos.
    .args = liquidação, vencimento, taxa, preço, resgate, frequência, [base_contagem]
fn-YIELDDISC = Rendimento anual de um título com desconto.
    .args = liquidação, vencimento, preço, resgate, [base_contagem]
fn-YIELDMAT = Rendimento anual de um título que paga juros no vencimento.
    .args = liquidação, vencimento, emissão, taxa, preço, [base_contagem]
fn-Z-TEST = Probabilidade unicaudal de um teste z.
    .args = matriz, x, [sigma]
fn-ZTEST = Probabilidade unicaudal de um teste z.
    .args = matriz, x, [sigma]
