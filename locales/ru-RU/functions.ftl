# Original Russian wording for GridCraft; keys, attributes and variables follow en-US.
# Function descriptions and argument labels; brackets mark optional parameters, ... marks repetition.
fn-ABS = Абсолютное значение числа.
    .args = число
fn-ACCRINT = Накопленный процентный доход по ценной бумаге с периодической выплатой процентов.
    .args = дата_выпуска, дата_первой_выплаты, дата_расчета, ставка, номинал, частота, [базис], [метод_расчета]
fn-ACCRINTM = Накопленный процентный доход по ценной бумаге с выплатой процентов при погашении.
    .args = дата_выпуска, дата_расчета, ставка, [номинал], [базис]
fn-ACOS = Арккосинус в радианах.
    .args = число
fn-ACOSH = Обратный гиперболический косинус.
    .args = число
fn-ACOT = Арккотангенс в радианах (от 0 до π).
    .args = число
fn-ACOTH = Обратный гиперболический котангенс.
    .args = число
fn-ADDRESS = Формирует текстовый адрес ячейки по номерам строки и столбца.
    .args = номер_строки, номер_столбца, [тип_ссылки], [a1], [имя_листа]
fn-AGGREGATE = Вычисляет агрегатное значение с возможностью пропускать скрытые строки и ошибки.
    .args = номер_функции, параметры, ссылка1, ...
fn-AMORDEGRC = Амортизация по французскому методу уменьшающегося остатка с коэффициентом на основе срока службы.
    .args = стоимость, дата_приобретения, конец_первого_периода, остаточная_стоимость, период, ставка, [базис]
fn-AMORLINC = Амортизация по французскому линейному методу с пропорциональным расчетом за первый период.
    .args = стоимость, дата_приобретения, конец_первого_периода, остаточная_стоимость, период, ставка, [базис]
fn-AND = ИСТИНА, если все аргументы имеют значение ИСТИНА.
    .args = логическое_значение1, [логическое_значение2], ...
fn-ARABIC = Преобразует запись римскими цифрами в число.
    .args = текст
fn-AREAS = Количество областей в ссылке.
    .args = ссылка
fn-ARRAYTOTEXT = Преобразует массив в текст: список через запятую или константу массива в строгом формате.
    .args = массив, [формат]
fn-ASC = Преобразует полноширинные символы в полуширинные (однобайтовый текст не меняется).
    .args = текст
fn-ASIN = Арксинус в радианах.
    .args = число
fn-ASINH = Обратный гиперболический синус.
    .args = число
fn-ATAN = Арктангенс в радианах.
    .args = число
fn-ATAN2 = Угол между осью x и направлением на точку (x, y) в радианах.
    .args = координата_x, координата_y
fn-ATANH = Обратный гиперболический тангенс.
    .args = число
fn-AVEDEV = Среднее абсолютное отклонение от среднего значения.
    .args = число1, [число2], ...
fn-AVERAGE = Среднее арифметическое чисел.
    .args = число1, [число2], ...
fn-AVERAGEA = Среднее значение с учетом текста как 0 и логических значений как 1 или 0.
    .args = значение1, [значение2], ...
fn-AVERAGEIF = Среднее значение ячеек, соответствующих условию.
    .args = диапазон, условие, [диапазон_усреднения]
fn-AVERAGEIFS = Среднее значение ячеек, соответствующих всем условиям.
    .args = диапазон_усреднения, диапазон_условия1, условие1, ...
fn-BASE = Записывает число в другой системе счисления с дополнением нулями.
    .args = число, основание, [минимальная_длина]
fn-BESSELI = Модифицированная функция Бесселя первого рода, I_n(x).
    .args = x, n
fn-BESSELJ = Функция Бесселя первого рода, J_n(x).
    .args = x, n
fn-BESSELK = Модифицированная функция Бесселя второго рода, K_n(x).
    .args = x, n
fn-BESSELY = Функция Бесселя второго рода, Y_n(x).
    .args = x, n
fn-BETA-DIST = Плотность или вероятность бета-распределения.
    .args = x, alpha, beta, интегральная, [A], [B]
fn-BETA-INV = Обратная функция интегрального бета-распределения.
    .args = вероятность, alpha, beta, [A], [B]
fn-BETADIST = Накопленная вероятность бета-распределения.
    .args = x, alpha, beta, [A], [B]
fn-BETAINV = Обратная функция интегрального бета-распределения.
    .args = вероятность, alpha, beta, [A], [B]
fn-BIN2DEC = Преобразует двоичное число в десятичное.
    .args = число
fn-BIN2HEX = Преобразует двоичное число в шестнадцатеричное.
    .args = число, [число_разрядов]
fn-BIN2OCT = Преобразует двоичное число в восьмеричное.
    .args = число, [число_разрядов]
fn-BINOM-DIST = Вероятность биномиального распределения.
    .args = число_успехов, число_испытаний, вероятность_успеха, интегральная
fn-BINOM-DIST-RANGE = Вероятность того, что число успехов попадет в заданный диапазон.
    .args = число_испытаний, вероятность_успеха, число_успехов, [число_успехов2]
fn-BINOM-INV = Наименьшее число успехов, при котором накопленная биномиальная вероятность достигает alpha.
    .args = число_испытаний, вероятность_успеха, alpha
fn-BINOMDIST = Вероятность биномиального распределения.
    .args = число_успехов, число_испытаний, вероятность_успеха, интегральная
fn-BITAND = Побитовое И двух неотрицательных целых чисел.
    .args = число1, число2
fn-BITLSHIFT = Сдвигает биты числа влево (вправо при отрицательном сдвиге).
    .args = число, величина_сдвига
fn-BITOR = Побитовое ИЛИ двух неотрицательных целых чисел.
    .args = число1, число2
fn-BITRSHIFT = Сдвигает биты числа вправо (влево при отрицательном сдвиге).
    .args = число, величина_сдвига
fn-BITXOR = Побитовое исключающее ИЛИ двух неотрицательных целых чисел.
    .args = число1, число2
fn-BYCOL = Применяет функцию LAMBDA к каждому столбцу.
    .args = массив, лямбда
fn-BYROW = Применяет функцию LAMBDA к каждой строке.
    .args = массив, лямбда
fn-CEILING = Округляет число вверх до кратного заданному шагу.
    .args = число, шаг
fn-CEILING-MATH = Округляет число вверх до ближайшего целого или кратного заданному шагу.
    .args = число, [шаг], [режим]
fn-CEILING-PRECISE = Округляет число в сторону плюс бесконечности до кратного заданному шагу.
    .args = число, [шаг]
fn-CELL = Сведения о ячейке.
    .args = тип_сведений, [ссылка]
fn-CHAR = Возвращает символ по коду из набора символов Windows-1252.
    .args = число
fn-CHIDIST = Правосторонняя вероятность распределения хи-квадрат.
    .args = x, степени_свободы
fn-CHIINV = Обратная функция правостороннего распределения хи-квадрат.
    .args = вероятность, степени_свободы
fn-CHISQ-DIST = Плотность или левосторонняя вероятность распределения хи-квадрат.
    .args = x, степени_свободы, интегральная
fn-CHISQ-DIST-RT = Правосторонняя вероятность распределения хи-квадрат.
    .args = x, степени_свободы
fn-CHISQ-INV = Обратная функция левостороннего распределения хи-квадрат.
    .args = вероятность, степени_свободы
fn-CHISQ-INV-RT = Обратная функция правостороннего распределения хи-квадрат.
    .args = вероятность, степени_свободы
fn-CHISQ-TEST = Проверка независимости по критерию хи-квадрат.
    .args = диапазон_наблюдений, диапазон_ожидаемых_значений
fn-CHITEST = Проверка независимости по критерию хи-квадрат.
    .args = диапазон_наблюдений, диапазон_ожидаемых_значений
fn-CHOOSE = Выбирает значение из списка по его позиции.
    .args = номер_позиции, значение1, [значение2], ...
fn-CHOOSECOLS = Выбирает столбцы массива по позиции (отрицательные номера отсчитываются от конца).
    .args = массив, номер_столбца1, [номер_столбца2], ...
fn-CHOOSEROWS = Выбирает строки массива по позиции (отрицательные номера отсчитываются от конца).
    .args = массив, номер_строки1, [номер_строки2], ...
fn-CLEAN = Удаляет из текста непечатаемые управляющие символы.
    .args = текст
fn-CODE = Возвращает код первого символа текста в кодировке Windows-1252.
    .args = текст
fn-COLUMN = Номер столбца по ссылке.
    .args = [ссылка]
fn-COLUMNS = Подсчитывает столбцы в массиве или диапазоне.
    .args = массив
fn-COMBIN = Количество сочетаний без повторений.
    .args = число_элементов, число_выбранных
fn-COMBINA = Количество сочетаний с повторениями.
    .args = число_элементов, число_выбранных
fn-COMPLEX = Формирует текстовую запись комплексного числа по действительной и мнимой частям.
    .args = действительная_часть, мнимая_часть, [суффикс]
fn-CONCAT = Объединяет текст из значений и всех ячеек диапазонов без разделителя.
    .args = текст1, [текст2], ...
fn-CONCATENATE = Объединяет несколько текстовых значений в одно.
    .args = текст1, [текст2], ...
fn-CONFIDENCE = Половина ширины доверительного интервала на основе нормального распределения.
    .args = alpha, стандартное_отклонение, размер_выборки
fn-CONFIDENCE-NORM = Половина ширины доверительного интервала на основе нормального распределения.
    .args = alpha, стандартное_отклонение, размер_выборки
fn-CONFIDENCE-T = Половина ширины доверительного интервала на основе t-распределения Стьюдента.
    .args = alpha, стандартное_отклонение, размер_выборки
fn-CONVERT = Переводит величину из одной единицы измерения в другую.
    .args = число, исходная_единица, целевая_единица
fn-CORREL = Коэффициент корреляции двух наборов данных.
    .args = массив1, массив2
fn-COS = Косинус угла, заданного в радианах.
    .args = число

fn-COSH = Гиперболический косинус.
    .args = число
fn-COT = Котангенс угла в радианах.
    .args = число
fn-COTH = Гиперболический котангенс.
    .args = число
fn-COUNT = Подсчитывает числовые значения.
    .args = значение1, [значение2], ...
fn-COUNTA = Подсчитывает непустые значения.
    .args = значение1, [значение2], ...
fn-COUNTBLANK = Подсчитывает пустые ячейки и пустой текст в диапазоне.
    .args = диапазон
fn-COUNTIF = Подсчитывает ячейки, удовлетворяющие условию.
    .args = диапазон, условие
fn-COUNTIFS = Подсчитывает ячейки, удовлетворяющие всем условиям.
    .args = диапазон_условия1, условие1, ...
fn-COUPDAYBS = Число дней от начала купонного периода до даты расчёта.
    .args = дата_расчёта, дата_погашения, частота, [базис]
fn-COUPDAYS = Число дней в купонном периоде, на который приходится дата расчёта.
    .args = дата_расчёта, дата_погашения, частота, [базис]
fn-COUPDAYSNC = Число дней от даты расчёта до следующей купонной выплаты.
    .args = дата_расчёта, дата_погашения, частота, [базис]
fn-COUPNCD = Дата следующей купонной выплаты после даты расчёта.
    .args = дата_расчёта, дата_погашения, частота, [базис]
fn-COUPNUM = Число купонных выплат между датами расчёта и погашения.
    .args = дата_расчёта, дата_погашения, частота, [базис]
fn-COUPPCD = Дата последней купонной выплаты, предшествующей дате расчёта или совпадающей с ней.
    .args = дата_расчёта, дата_погашения, частота, [базис]
fn-COVAR = Ковариация парных значений генеральной совокупности.
    .args = массив1, массив2
fn-COVARIANCE-P = Ковариация парных значений генеральной совокупности.
    .args = массив1, массив2
fn-COVARIANCE-S = Выборочная ковариация парных значений.
    .args = массив1, массив2
fn-CRITBINOM = Наименьшее число успехов, при котором накопленная вероятность биномиального распределения достигает alpha.
    .args = число_испытаний, вероятность_успеха, alpha
fn-CSC = Косеканс угла в радианах.
    .args = число
fn-CSCH = Гиперболический косеканс.
    .args = число
fn-CUBEKPIMEMBER = Возвращает свойство ключевого показателя эффективности из куба (подключения к кубам отсутствуют; #N/A).
    .args = подключение, имя_показателя, свойство_показателя, [подпись]
fn-CUBEMEMBER = Возвращает элемент или кортеж из куба (подключения к кубам отсутствуют; #N/A).
    .args = подключение, выражение_элемента, [подпись]
fn-CUBEMEMBERPROPERTY = Возвращает свойство элемента куба (подключения к кубам отсутствуют; #N/A).
    .args = подключение, выражение_элемента, свойство
fn-CUBERANKEDMEMBER = Возвращает n-й элемент набора куба (подключения к кубам отсутствуют; #N/A).
    .args = подключение, выражение_набора, позиция, [подпись]
fn-CUBESET = Определяет набор элементов куба (подключения к кубам отсутствуют; #N/A).
    .args = подключение, выражение_набора, [подпись], [порядок_сортировки], [критерий_сортировки]
fn-CUBESETCOUNT = Подсчитывает элементы в наборе куба (подключения к кубам отсутствуют; #N/A).
    .args = набор
fn-CUBEVALUE = Возвращает агрегированное значение из куба (подключения к кубам отсутствуют; #N/A).
    .args = подключение, [выражение_элемента1], ...
fn-CUMIPMT = Общая сумма процентов, выплаченных между двумя периодами.
    .args = ставка, число_периодов, текущая_стоимость, начальный_период, конечный_период, тип
fn-CUMPRINC = Общая сумма основного долга, погашенного между двумя периодами.
    .args = ставка, число_периодов, текущая_стоимость, начальный_период, конечный_период, тип
fn-DATE = Создаёт порядковый номер даты из года, месяца и дня.
    .args = год, месяц, день
fn-DATEDIF = Подсчитывает полные годы, месяцы или дни между двумя датами.
    .args = начальная_дата, конечная_дата, единица
fn-DATEVALUE = Преобразует дату, записанную текстом, в порядковый номер даты.
    .args = текст_даты
fn-DAVERAGE = Вычисляет среднее числовых значений поля для записей, удовлетворяющих условиям.
    .args = база_данных, поле, условия
fn-DAY = Возвращает день месяца для указанной даты.
    .args = серийное_число
fn-DAYS = Возвращает число дней между двумя датами.
    .args = конечная_дата, начальная_дата
fn-DAYS360 = Подсчитывает дни между двумя датами исходя из 360-дневного года (американский или европейский метод).
    .args = начальная_дата, конечная_дата, [метод]
fn-DB = Амортизация за период по методу уменьшаемого остатка с фиксированной ставкой.
    .args = начальная_стоимость, остаточная_стоимость, срок_службы, период, [число_месяцев]
fn-DBCS = Преобразует символы половинной ширины в полноширинные (в этой локали изменений нет).
    .args = текст
fn-DCOUNT = Подсчитывает числовые ячейки поля в подходящих записях (или сами подходящие записи).
    .args = база_данных, [поле], условия
fn-DCOUNTA = Подсчитывает непустые ячейки поля в подходящих записях (или сами подходящие записи).
    .args = база_данных, [поле], условия
fn-DDB = Амортизация за период по методу двойного уменьшаемого остатка (или с другим коэффициентом).
    .args = начальная_стоимость, остаточная_стоимость, срок_службы, период, [коэффициент]
fn-DEC2BIN = Преобразует десятичное число в двоичное.
    .args = число, [число_разрядов]
fn-DEC2HEX = Преобразует десятичное число в шестнадцатеричное.
    .args = число, [число_разрядов]
fn-DEC2OCT = Преобразует десятичное число в восьмеричное.
    .args = число, [число_разрядов]
fn-DECIMAL = Преобразует текст в число с учётом заданного основания системы счисления.
    .args = текст, основание
fn-DEGREES = Преобразует радианы в градусы.
    .args = угол
fn-DELTA = Возвращает 1, если два числа равны, иначе 0.
    .args = число1, [число2]
fn-DEVSQ = Сумма квадратов отклонений от среднего.
    .args = число1, [число2], ...
fn-DGET = Возвращает значение поля единственной записи, удовлетворяющей условиям.
    .args = база_данных, поле, условия
fn-DISC = Ставка дисконтирования ценной бумаги.
    .args = дата_расчёта, дата_погашения, цена, стоимость_погашения, [базис]
fn-DMAX = Наибольшее число в поле подходящих записей.
    .args = база_данных, поле, условия
fn-DMIN = Наименьшее число в поле подходящих записей.
    .args = база_данных, поле, условия
fn-DOLLAR = Представляет число в виде текста в денежном формате.
    .args = число, [десятичные_знаки]
fn-DOLLARDE = Преобразует дробную запись цены в десятичное число.
    .args = дробная_цена, знаменатель
fn-DOLLARFR = Преобразует десятичную цену в дробную запись.
    .args = десятичная_цена, знаменатель
