# Colour scale, data bar, icon set, top 10, formula and text rules
home.conditionalFormat={"range":"C5:F8","rule":{"type":"colorScale"}}
home.conditionalFormat={"range":"C5:C8","rule":{"type":"dataBar"}}
home.conditionalFormat={"range":"D5:D8","rule":{"type":"iconSet"}}
